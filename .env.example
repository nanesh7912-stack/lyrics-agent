# Optional. The project works fully without any of these.
# Only needed with  --llm openai  (or "llm_provider": "openai"): an OpenAI-compatible chat endpoint
# is asked to suggest a scene/mood per lyric line. It only ever receives the lyric text and can only choose
# from the built-in scene names; failures silently fall back to the local analysis.
AI_LYRICS_LLM_API_KEY=
AI_LYRICS_LLM_MODEL=gpt-4o-mini
AI_LYRICS_LLM_URL=https://api.openai.com/v1/chat/completions
